generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  IN_PROGRESS
  WON
  ABANDONED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  /// Display name shown on the public leaderboard. Null until the player finishes
  /// onboarding (existing accounts predate the field; GitHub prefills it, editable).
  name         String?
  /// College roll number, e.g. 21BD1A0501. Unique across players; null allows the
  /// many pre-onboarding rows to coexist. The /onboarding gate enforces presence.
  rollNumber   String?       @unique
  /// Null for OAuth-only accounts (GitHub). The Credentials path guards against null.
  passwordHash String?
  /// Per-user Groq key, AES-256-GCM encrypted as `iv:authTag:ciphertext`. Null until the user adds one.
  groqKeyEnc   String?
  createdAt    DateTime      @default(now())
  sessions     GameSession[]
  flags        Flag[]
}

/// One player's flag for one level: the prize a won session reveals, shaped
/// `BTB{uuid}`. Stable per (user, level) — generated on first play of a level
/// and reused on replays — so a captured flag stays that player's, and every
/// player's flag differs. The value is globally unique.
model Flag {
  id        String        @id @default(cuid())
  userId    String
  level     Int
  value     String        @unique
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
  sessions  GameSession[]

  @@unique([userId, level])
}

/// Retired: the old shared per-level words. Kept so historic sessions still
/// resolve their `revealedWord`, but new sessions carry a per-user `flagId`
/// instead and leave `wordId` null. Not offered to new gameplay.
model Word {
  id       String        @id @default(cuid())
  text     String        @unique
  /// The level this word guarded. Null for a retired pool word.
  level    Int?          @unique
  active   Boolean       @default(true)
  sessions GameSession[]
}

model GameSession {
  id        String        @id @default(cuid())
  userId    String
  /// Legacy: the shared Word a historic session guarded. Null for flag-era sessions.
  wordId    String?
  /// The per-user flag this session guards. Null only for legacy word-era rows.
  flagId    String?
  level     Int
  status    SessionStatus @default(IN_PROGRESS)
  /// Set when a session exceeds 20 attempts in 5 minutes, i.e. looks automated.
  flagged   Boolean       @default(false)
  createdAt DateTime      @default(now())
  endedAt   DateTime?
  user      User          @relation(fields: [userId], references: [id])
  word      Word?         @relation(fields: [wordId], references: [id])
  flag      Flag?         @relation(fields: [flagId], references: [id])
  attempts  Attempt[]

  @@index([userId, level])
  @@index([userId, status])
}

model Attempt {
  id          String      @id @default(cuid())
  sessionId   String
  /// The player's raw message. Sanitisation happens when the prompt history is
  /// rebuilt, so the original attack text stays available for review.
  userMessage String
  aiResponse  String
  leaked      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  session     GameSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
}
