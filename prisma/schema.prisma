generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  IN_PROGRESS
  WON
  ABANDONED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  /// Display name shown on the public leaderboard. Null until the player finishes
  /// onboarding (existing accounts predate the field; GitHub prefills it, editable).
  name         String?
  /// College roll number, e.g. 21BD1A0501. Unique across players; null allows the
  /// many pre-onboarding rows to coexist. The /onboarding gate enforces presence.
  rollNumber   String?       @unique
  /// Null for OAuth-only accounts (GitHub). The Credentials path guards against null.
  passwordHash String?
  /// Per-user Groq key, AES-256-GCM encrypted as `iv:authTag:ciphertext`. Null until the user adds one.
  groqKeyEnc   String?
  createdAt    DateTime      @default(now())
  sessions     GameSession[]
}

/// The six level words, each pinned to the level that guards it, plus the words
/// retired from the old three-tier pool. A retired word keeps its row — so an
/// old session could still resolve it — but carries `active = false` and no
/// level. A word is never shorter than four letters: the leak scanner's
/// separator-squeeze layer relies on that floor to avoid matching short words
/// inside ordinary prose.
model Word {
  id       String        @id @default(cuid())
  text     String        @unique
  /// The level this word guards. Null for a retired pool word.
  level    Int?          @unique
  active   Boolean       @default(true)
  sessions GameSession[]
}

model GameSession {
  id        String        @id @default(cuid())
  userId    String
  wordId    String
  level     Int
  status    SessionStatus @default(IN_PROGRESS)
  /// Set when a session exceeds 20 attempts in 5 minutes, i.e. looks automated.
  flagged   Boolean       @default(false)
  createdAt DateTime      @default(now())
  endedAt   DateTime?
  user      User          @relation(fields: [userId], references: [id])
  word      Word          @relation(fields: [wordId], references: [id])
  attempts  Attempt[]

  @@index([userId, level])
  @@index([userId, status])
}

model Attempt {
  id          String      @id @default(cuid())
  sessionId   String
  /// The player's raw message. Sanitisation happens when the prompt history is
  /// rebuilt, so the original attack text stays available for review.
  userMessage String
  aiResponse  String
  leaked      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  session     GameSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
}
